# Translation
# Providers: google (scraped web endpoint), deepl (official API, needs a
# key), lingva (a self-hosted Lingva instance, needs its URL), mymemory
# (translation-memory, free, needs no key).
# The primary answers first; when it refuses, the fallback is tried.
TRANSLATION_PRIMARY=google
TRANSLATION_FALLBACK=mymemory

# Credentials for the providers that need them. Unused ones stay empty.
TRANSLATION_DEEPL_API_KEY=
# e.g. https://lingva.example.com (no trailing path)
TRANSLATION_LINGVA_URL=

# Redis (TaskIQ broker + progress store)
# Docker: redis://redis:6379 (auto-set, no need to change)
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# App
# One shared password for writes (uploads, saves, translations) until
# account auth replaces it. Leave empty to refuse all writes.
APP_PASSWORD=
APP_DEBUG=false
APP_TEMP_DIR=/tmp/worktools
APP_MAX_UPLOAD_MB=200

# JP Reader (photograph a Japanese page, tap a word, get its reading)
JR_TARGET_LANG=en
JR_MAX_IMAGES=50
JR_TTL_DAYS=7
JR_MAX_DIM=2000

# JP Translator (two-way Japanese↔English translation with furigana)
JPT_MAX_CHARS=2000
